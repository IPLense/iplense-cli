#!/usr/bin/env bash
# Test stand-in for curl: answers from fixture files instead of the network.
# Self-check: STUB_V4 / STUB_V6 name a fixture ("name:status", e.g. "full-v4.kv:200"); unset means that family has no
# connection. Platform pages: STUB_LOCAL names a directory under fixtures/local whose <key>.txt holds "<code> <final URL>"
# on its first line and the body after it; a missing file is a failed connection. A trace's ip6= line is its ip= over IPv6.
# A request for the first redirect only (-w ...redirect_url) gets that first line, "<code> <redirect URL>", and no body.
family=4 format=kv lang=en url='' effective=0 redirect=0
for arg in "$@"; do
	case $arg in
	-4) family=4 ;;
	-6) family=6 ;;
	https://* | http://*) url=$arg ;;
	esac
	case $arg in *format=json*) format=json ;; esac
	case $arg in *lang=zh*) lang=zh ;; esac
	case $arg in *url_effective*) effective=1 ;; esac
	case $arg in *redirect_url*) redirect=1 ;; esac
done
fixtures=$(dirname "$0")/../fixtures
[ -n "${STUB_LOG-}" ] && printf '%s\n' "$*" >>"$STUB_LOG"

case $url in
https://iplense.cc/cli/v1/report)
	previous=''
	for arg in "$@"; do
		[ "$previous" = --data ] && printf '%s' "$arg" >"$(dirname "$0")/../.work/report.json"
		previous=$arg
	done
	case ${STUB_REPORT-success} in
	success) printf '{"schema":"cli-report/1","url":"https:\\/\\/iplense.cc\\/r\\/AAAAAAAAAAAAAAAAAAAAAA.svg","expiresAt":"2026-11-04T01:00:00Z"}\n200' ;;
	limited) printf '{"schema":"cli-report/1","error":"rate_limited","scope":"ip","retryAfter":600}\n429' ;;
	disabled) printf '{"schema":"cli-report/1","error":"report_disabled","retryAfter":600}\n503' ;;
	expired) printf '{"schema":"cli-report/1","error":"report_token_expired","field":"reportTokens.0"}\n410' ;;
	mismatch) printf '{"schema":"cli-report/1","error":"report_token_mismatch"}\n403' ;;
	invalid) printf '{"schema":"cli-report/1","error":"invalid_field","field":"local.0.family"}\n400' ;;
	network) exit 7 ;;
	esac
	exit 0
	;;
https://iplense.cc/*)
	name=STUB_V$family
	spec=${!name-}
	[ -z "$spec" ] && exit 7
	file=${spec%%:*} status=${spec##*:}
	if [ "$format" = json ]; then
		printf '{"schema":"cli-self/1","ip":"%s","quick":{"ip":"%s","asn":{"route":"203.0.113.0/24"},"company":{"netname":"EXAMPLE-NET"}},"professional":{"ip":"%s"},"aiRegions":{"version":"stub","chatgpt":"CA,US","claude":"CA,US"}}' "$(sed -n 's/^ip=//p' "$fixtures/$file")" "$(sed -n 's/^ip=//p' "$fixtures/$file")" "$(sed -n 's/^ip=//p' "$fixtures/$file")"
	else
		cat "$fixtures/$file"
		# A result carries the site's words in the requested language and the AI lists, as the server adds them.
		if [ "$status" = 200 ] && grep -q '^ip=' "$fixtures/$file" && ! grep -q '^error=' "$fixtures/$file"; then
			cat "$fixtures/labels-$lang.kv" "$fixtures/ai-regions.kv"
		fi
	fi
	printf '\n%s' "$status"
	exit 0
	;;
*chatgpt.com/cdn-cgi/trace) key=chatgpt ;;
*claude.ai/cdn-cgi/trace) key=claude ;;
*gemini.google.com*) key=gemini ;;
*notebooklm.google.com*) key=notebooklm ;;
*netflix.com/title/81280792) key=netflix-original ;;
*netflix.com/title/70143836) key=netflix-licensed ;;
*bamgrid.com/devices) key=disney-devices ;;
*bamgrid.com/token) key=disney-token ;;
*bamgrid.com/graph/*) key=disney-graphql ;;
*youtube.com/premium*) key=youtube ;;
*tiktok.com/*) key=tiktok ;;
*primevideo.com*) key=prime ;;
*reddit.com/*) key=reddit ;;
*) exit 6 ;;
esac
page=$fixtures/local/${STUB_LOCAL-}/$key.txt
[ -n "${STUB_LOCAL-}" ] && [ -f "$page" ] || exit 7
head_line=$(head -n 1 "$page")
[ "$redirect" = 1 ] && { printf '%s' "$head_line"; exit 0; }
# A trace answers in the family it was asked over, as the real one does: ip6= stands in for ip= over IPv6.
if [ "$family" = 6 ]; then
	tail -n +2 "$page" | sed -e '/^ip=/d' -e 's/^ip6=/ip=/'
else
	tail -n +2 "$page" | sed '/^ip6=/d'
fi
[ "$effective" = 1 ] && printf '\n%s' "$head_line"
exit 0
